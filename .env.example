# Dossier TN - local development. Never commit this file.
# Azure OpenAI v1-compatible deployment. Fill these three values.
# Example base URL: https://YOUR-RESOURCE.openai.azure.com/openai/v1/
#              or:  https://YOUR-RESOURCE.services.ai.azure.com/models
# Use your deployment name, not a model catalog name or Foundry project URL.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
# auto disables thinking for Kimi-K2.5/K2.6 to keep interactive replies bounded.
# For a custom deployment alias of these models, set disabled explicitly.
AZURE_MODEL_THINKING=auto

# Optional: OCR for scanned Arabic/French documents.
# When absent, scanned pages use the vision-capable chat deployment.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Local development only. Synthetic sample cases remain explicitly labelled.
DOSSIER_DATA_DIR=./.local-data
INTERNAL_API_URL=http://127.0.0.1:8000
DOSSIER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

